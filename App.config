<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <appSettings>
    <!-- Адрес и порт УТМ ЕГАИС. По умолчанию УТМ стоит на той же машине. -->
    <add key="UtmHost" value="127.0.0.1" />
    <add key="UtmPort" value="8080" />

    <!-- Имя службы УТМ, запуска которой робот ждёт перед началом работы. -->
    <add key="UtmServiceName" value="Transport" />

    <!-- Цена за 1 литр в рублях, используется для расчёта суммы в акте. -->
    <add key="PricePerLiter" value="100" />

    <!--
      Необязательный сервер обновлений и мониторинга.
      Оставьте пустыми, чтобы полностью отключить сеть за пределами УТМ.
      UpdateServerLocal  - адрес внутри локальной сети
      UpdateServerPublic - адрес снаружи
      LocalProbeHost     - хост, по доступности которого определяется локальная сеть
    -->
    <add key="UpdateServerLocal" value="" />
    <add key="UpdateServerPublic" value="" />
    <add key="UpdateServerPort" value="4401" />
    <add key="LocalProbeHost" value="" />

    <!--
      ВНИМАНИЕ: обе опции ниже по умолчанию выключены и требуют осознанного включения.

      EnableAutostart  - прописать программу в HKCU\...\Run при запуске.
      EnableAutoUpdate - скачивать и запускать обновление с UpdateServer по HTTP.
                         Подпись и хеш загруженного файла НЕ проверяются,
                         см. раздел "Безопасность" в README.
    -->
    <add key="EnableAutostart" value="false" />
    <add key="EnableAutoUpdate" value="false" />
  </appSettings>
</configuration>
